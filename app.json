{
  "expo": {
    "name": "Photinder",
    "slug": "photinder",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "photinder",
    "plugins": [
      [
        "expo-media-library",
        {
          "photosPermission": "Photinder deve accedere a foto e video per mostrarti la galleria.",
          "savePhotosPermission": "Photinder deve poter modificare la galleria solo quando confermi un'eliminazione.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": ["photo", "video"]
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ]
    ],
    "android": {
      "package": "com.photinder.app",
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "READ_MEDIA_VISUAL_USER_SELECTED"
      ]
    }
  }
}
