{
  "name": "photinder",
  "version": "0.2.0",
  "private": true,
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "prebuild:android": "expo prebuild --platform android",
    "build:apk": "npx eas-cli build -p android --profile preview",
    "build:ios": "npx eas-cli build -p ios --profile preview",
    "build:ios:store": "npx eas-cli build -p ios --profile production",
    "test": "node --test tests/*.test.cjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "expo": "~57.0.31",
    "expo-image": "~57.0.5",
    "expo-media-library": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-video": "~57.0.5",
    "lucide-react-native": "^1.61.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "babel-preset-expo": "^57.0.1",
    "typescript": "~6.0.3"
  }
}
